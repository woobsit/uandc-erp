{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
      "strict": true,
      "types": ["vitest/globals"],
      "moduleResolution": "bundler",
      "module": "ESNext",
      "target": "ESNext",
      "jsx": "preserve",
      "baseUrl": ".",
      "paths": {
        "~/*": ["./*"],
        "@/*": ["./*"]
      },
      "vueCompilerOptions": {
        "target": 3,
        "plugins": ["@volar/vue-language-plugin-pug"]
      }
    },
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.vue",
      ".nuxt/**/*.ts",
      "nuxt.config.ts",
      "types/**/*.d.ts"
    ],
    "exclude": [
      "node_modules"
    ]
  }